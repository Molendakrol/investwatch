# Copy to .env and change the secrets before running: cp .env.example .env
POSTGRES_PASSWORD=change-me-postgres
INTERNAL_TOKEN=change-me-internal-token

# Scheduler
SWEEP_INTERVAL_MINUTES=30
REGISTER_INTERVAL_HOURS=24
DEFAULT_THRESHOLD=50

# Scraper
WORKER_CONCURRENCY=3
FETCH_MIN_INTERVAL_SECONDS=1.0
RESPECT_ROBOTS=true
# Optional comma-separated proxy pool, rotated per request: http://user:pass@proxy1:3128,http://proxy2:3128
PROXIES=

# Optional local LLM (docker compose --profile llm up): second opinion in module 3
OLLAMA_URL=
OLLAMA_MODEL=gemma3:1b
